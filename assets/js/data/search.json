---
layout: compress
swcache: true
---

{% assign private_cat_names = site.data.categories | where: "type", "private" | map: "name" %}

[
  {% for post in site.posts %}
    {% assign post_is_private = false %}
    {% for cat in post.categories %}
      {% if private_cat_names contains cat %}{% assign post_is_private = true %}{% endif %}
    {% endfor %}
    {%- capture description -%}
      {% include post-description.html %}
    {%- endcapture -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "categories": {{ post.categories | join: ', ' | jsonify }},
    "tags": {{ post.tags | join: ', ' | jsonify }},
    "date": "{{ post.date }}",
    "content": "{{ description }}",
    "private": {{ post_is_private }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
